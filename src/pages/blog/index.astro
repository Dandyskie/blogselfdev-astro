---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ArticleSearchFilter from '../../components/react/ArticleSearchFilter';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const articlesForReact = posts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description: post.data.description,
	pubDate: post.data.pubDate.toLocaleDateString('id-ID', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}),
	category: post.data.category || 'Mindset',
	readingTime: post.data.readingTime || '5 menit baca',
	heroImage: post.data.heroImage?.src || '',
	author: post.data.author || 'Tim Redaksi',
}));
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={`Indeks Arsip Tulisan | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#fafaf9] text-stone-900 antialiased selection:bg-stone-900 selection:text-white">
		<Header />
		<main class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
			<!-- Header Section -->
			<div class="mb-10 pb-6 border-b border-stone-200">
				<span class="text-xs font-semibold uppercase tracking-widest text-stone-500 block mb-1">
					Indeks Publikasi
				</span>
				<h1 class="text-3xl sm:text-5xl font-black text-stone-900 tracking-tight mb-3">
					Semua Tulisan & Arsip Editorial
				</h1>
				<p class="text-xs sm:text-sm text-stone-600 max-w-xl leading-relaxed">
					Kumpulan panduan, catatan reflektif, dan strategi hidup mandiri untuk generasi usia 18 sampai 30 tahun.
				</p>
			</div>

			<!-- React Search & Filter Island -->
			<ArticleSearchFilter client:load initialArticles={articlesForReact} />
		</main>
		<Footer />
	</body>
</html>
