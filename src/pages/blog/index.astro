---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import ArticleSearchFilter from '../../components/react/ArticleSearchFilter';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const articlesForReact = posts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description: post.data.description,
	pubDate: post.data.pubDate.toLocaleDateString('id-ID', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}),
	category: post.data.category || 'Mindset',
	readingTime: post.data.readingTime || '5 menit baca',
	heroImage: post.data.heroImage?.src || '',
}));
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={`Daftar Lengkap Artikel - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-500 selection:text-white">
		<Header />
		<main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
			<!-- Header Section -->
			<div class="text-center max-w-3xl mx-auto mb-12">
				<div class="inline-flex items-center gap-2 bg-emerald-100 text-emerald-800 text-xs font-semibold px-3 py-1 rounded-full border border-emerald-200 mb-3">
					📚 Arsip Tulisan & Wawasan
				</div>
				<h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-4">
					Semua Artikel Pengembangan Diri
				</h1>
				<p class="text-sm sm:text-base text-slate-600 leading-relaxed">
					Temukan seluruh panduan praktis, teknik mindfulness, dan strategi produktivitas terkurasi untuk memandu perjalanan bertumbuh Anda.
				</p>
			</div>

			<!-- React Search & Filter Island -->
			<ArticleSearchFilter client:load initialArticles={articlesForReact} />
		</main>
		<Footer />
	</body>
</html>
