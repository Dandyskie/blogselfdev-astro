---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ArticleSearchFilter from '../components/react/ArticleSearchFilter';
import DailyHabitTracker from '../components/vue/DailyHabitTracker.vue';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_TAGLINE } from '../consts';

// Ambil data tulisan dari Content Collections
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = allPosts.find((p) => p.data.featured) || allPosts[0];
const recentPosts = allPosts.filter((p) => p.id !== featuredPost?.id);

// Siapkan data untuk komponen pencarian React
const articlesForReact = allPosts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description: post.data.description,
	pubDate: post.data.pubDate.toLocaleDateString('id-ID', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}),
	category: post.data.category || 'Mindset',
	readingTime: post.data.readingTime || '5 menit baca',
	heroImage: post.data.heroImage?.src || '',
	author: post.data.author || 'Tim Redaksi',
}));
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={`${SITE_TITLE} | ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-[#fafaf9] text-stone-900 antialiased selection:bg-stone-900 selection:text-white">
		<Header />

		<main class="w-full">
			<!-- Editorial Masthead / Header Bar -->
			<section class="border-b border-stone-200 bg-white">
				<div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 sm:py-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
					<div>
						<span class="text-xs font-semibold uppercase tracking-widest text-stone-500 block mb-1">
							Edisi Publikasi Terbuka
						</span>
						<h1 class="text-3xl sm:text-4xl font-black tracking-tight text-stone-900">
							Catatan & Perspektif Hidup Dewasa Muda
						</h1>
					</div>
					<div class="text-xs text-stone-500 max-w-sm leading-relaxed">
						Menavigasi ketidakpastian karir, kesehatan mental, dan kebiasaan sadar bagi generasi 18 sampai 30 tahun.
					</div>
				</div>
			</section>

			<!-- Lead Editorial Story (Featured Article) -->
			{featuredPost && (
				<section class="max-w-6xl mx-auto px-4 sm:px-6 py-10 sm:py-14 border-b border-stone-200">
					<article class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
						<div class="lg:col-span-7 order-2 lg:order-1 flex flex-col justify-center">
							<div class="flex items-center gap-2.5 text-xs text-stone-500 mb-4 font-medium">
								<span class="text-stone-900 font-bold uppercase tracking-wider text-[11px] bg-stone-100 px-2 py-0.5 rounded">
									{featuredPost.data.category}
								</span>
								<span>•</span>
								<span>
									<FormattedDate date={featuredPost.data.pubDate} />
								</span>
								<span>•</span>
								<span>{featuredPost.data.readingTime || '6 menit baca'}</span>
							</div>

							<h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-stone-900 leading-[1.15] mb-5 hover:text-stone-700 transition-colors">
								<a href={`/blog/${featuredPost.id}/`}>
									{featuredPost.data.title}
								</a>
							</h2>

							<p class="text-stone-600 text-sm sm:text-base leading-relaxed mb-6">
								{featuredPost.data.description}
							</p>

							<div class="flex items-center justify-between pt-4 border-t border-stone-200">
								<span class="text-xs text-stone-500 font-medium">
									Ditulis oleh {featuredPost.data.author || 'Raka Pratama'}
								</span>
								<a
									href={`/blog/${featuredPost.id}/`}
									class="min-h-[44px] inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-stone-900 hover:text-stone-600 transition-colors"
								>
									<span>Baca Tulisan Ini</span>
									<span>→</span>
								</a>
							</div>
						</div>

						<a
							href={`/blog/${featuredPost.id}/`}
							class="lg:col-span-5 order-1 lg:order-2 block aspect-[16/10] bg-stone-100 rounded-xl overflow-hidden border border-stone-200 group"
						>
							{featuredPost.data.heroImage && (
								<Image
									src={featuredPost.data.heroImage}
									alt={featuredPost.data.title}
									width={800}
									height={500}
									fetchpriority="high"
									loading="eager"
									class="w-full h-full object-cover group-hover:scale-102 transition-transform duration-300"
								/>
							)}
						</a>
					</article>
				</section>
			)}

			<!-- Editorial Pillars (3 Core Pillars) -->
			<section class="max-w-6xl mx-auto px-4 sm:px-6 py-12 border-b border-stone-200">
				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					<div class="border-t-2 border-stone-900 pt-4">
						<span class="text-xs font-mono text-stone-400 block mb-1">01 / Mental</span>
						<h3 class="text-base font-bold text-stone-900 mb-2">Mengurai Quarter-Life Crisis</h3>
						<p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
							Meredakan perbandingan sosial di media sosial dan membangun rasa aman pada kecepatan perjalanan hidup sendiri.
						</p>
					</div>

					<div class="border-t-2 border-stone-900 pt-4">
						<span class="text-xs font-mono text-stone-400 block mb-1">02 / Atensi</span>
						<h3 class="text-base font-bold text-stone-900 mb-2">Keluar dari Distraksi Instan</h3>
						<p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
							Mengembalikan daya konsentrasi otak yang terkuras akibat gulir video kilat dan notifikasi tanpa henti.
						</p>
					</div>

					<div class="border-t-2 border-stone-900 pt-4">
						<span class="text-xs font-mono text-stone-400 block mb-1">03 / Batasan</span>
						<h3 class="text-base font-bold text-stone-900 mb-2">Batasan Sehat & Karir</h3>
						<p class="text-xs sm:text-sm text-stone-600 leading-relaxed">
							Menolak eksploitasi kerja berlebih secara profesional tanpa mengorbankan kesehatan fisik dan relasi sosial.
						</p>
					</div>
				</div>
			</section>

			<!-- Interactive Habit Tracker (VUE ISLAND) -->
			<section id="habit-log" class="max-w-6xl mx-auto px-4 sm:px-6 py-14 border-b border-stone-200">
				<div class="max-w-3xl mx-auto">
					<DailyHabitTracker client:visible />
				</div>
			</section>

			<!-- Interactive Article Index & Filter (REACT ISLAND) -->
			<section class="max-w-6xl mx-auto px-4 sm:px-6 py-14">
				<div class="mb-8">
					<span class="text-xs font-semibold uppercase tracking-widest text-stone-500 block mb-1">
						Indeks Publikasi
					</span>
					<h2 class="text-2xl sm:text-3xl font-black tracking-tight text-stone-900">
						Seluruh Arsip Tulisan
					</h2>
				</div>

				<!-- React Search & Filter Island -->
				<ArticleSearchFilter client:load initialArticles={articlesForReact} />
			</section>

			<!-- Newsletter Section -->
			<section class="bg-white border-t border-stone-200 py-16">
				<div class="max-w-3xl mx-auto px-4 sm:px-6 text-center space-y-4">
					<span class="text-xs font-bold uppercase tracking-widest text-stone-500">
						Buletin Dwi-Mingguan
					</span>
					<h3 class="text-2xl sm:text-3xl font-black text-stone-900 tracking-tight">
						Refleksi Singkat Langsung ke Kotak Masuk Anda
					</h3>
					<p class="text-xs sm:text-sm text-stone-600 max-w-lg mx-auto leading-relaxed">
						Satu catatan reflektif seputar kesehatan batin, manajemen waktu, dan psikologi kerja yang dikirim setiap Minggu pagi. Bebas iklan dan tanpa promosi kosong.
					</p>

					<form onsubmit="event.preventDefault(); alert('Terima kasih. Konfirmasi langganan telah dikirimkan ke alamat surel Anda.');" class="flex flex-col sm:flex-row gap-2 max-w-md mx-auto pt-4">
						<label for="newsletter-email" class="sr-only">Alamat email</label>
						<input
							id="newsletter-email"
							type="email"
							placeholder="nama@email.com"
							required
							class="flex-1 min-h-[44px] bg-stone-50 border border-stone-300 rounded-md px-3.5 text-xs sm:text-sm text-stone-900 placeholder-stone-400 focus:outline-none focus:border-stone-900"
						/>
						<button
							type="submit"
							class="min-h-[44px] px-5 bg-stone-900 hover:bg-stone-800 text-stone-50 text-xs font-semibold rounded-md transition-colors shrink-0 cursor-pointer"
						>
							Berlangganan
						</button>
					</form>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
