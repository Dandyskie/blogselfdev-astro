---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ArticleSearchFilter from '../components/react/ArticleSearchFilter';
import DailyHabitTracker from '../components/vue/DailyHabitTracker.vue';
import { SITE_DESCRIPTION, SITE_TITLE, SITE_TAGLINE } from '../consts';

// Ambil data artikel dari Content Collections
const allPosts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = allPosts.find((p) => p.data.featured) || allPosts[0];

// Format data yang akan dikirimkan ke komponen React
const articlesForReact = allPosts.map((post) => ({
	id: post.id,
	title: post.data.title,
	description: post.data.description,
	pubDate: post.data.pubDate.toLocaleDateString('id-ID', {
		year: 'numeric',
		month: 'short',
		day: 'numeric',
	}),
	category: post.data.category || 'Mindset',
	readingTime: post.data.readingTime || '5 menit baca',
	heroImage: post.data.heroImage?.src || '',
}));
---

<!doctype html>
<html lang="id" class="scroll-smooth">
	<head>
		<BaseHead title={`${SITE_TITLE} - ${SITE_TAGLINE}`} description={SITE_DESCRIPTION} />
	</head>
	<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-500 selection:text-white">
		<Header />

		<main class="w-full">
			<!-- Hero Section -->
			<section class="relative pt-12 pb-20 sm:pt-20 sm:pb-28 overflow-hidden bg-gradient-to-b from-white via-emerald-50/30 to-slate-50 border-b border-slate-200/60">
				<!-- Background Decorative Circles -->
				<div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-full overflow-hidden pointer-events-none -z-10">
					<div class="absolute -top-32 left-1/4 w-96 h-96 bg-emerald-200/40 rounded-full blur-3xl"></div>
					<div class="absolute top-20 right-10 w-80 h-80 bg-teal-200/30 rounded-full blur-3xl"></div>
				</div>

				<div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
					<!-- Pill Badge -->
					<div class="inline-flex items-center gap-2 bg-emerald-100/80 text-emerald-800 text-xs sm:text-sm font-semibold px-4 py-1.5 rounded-full border border-emerald-200 mb-6 shadow-sm">
						<span>🌱 Portal Pengembangan Diri & Mindset</span>
						<span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
						<span class="text-emerald-700 font-normal">Astro + React + Vue + Tailwind</span>
					</div>

					<h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.15] mb-6">
						Seni Bertumbuh <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700">1% Lebih Baik</span> Setiap Hari
					</h1>

					<p class="text-base sm:text-xl text-slate-600 max-w-2xl mx-auto mb-10 leading-relaxed font-normal">
						Eksplorasi wawasan psikologi terapan, rahasia membangun kebiasaan produktif, manajemen energi mental, dan inspirasi hidup bermakna.
					</p>

					<!-- Action Buttons -->
					<div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-14">
						<a
							href="#articles"
							class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-sm shadow-lg shadow-emerald-600/25 hover:shadow-xl transition-all"
						>
							<span>Jelajahi Artikel</span>
							<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
								<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M19 9l-7 7-7-7" />
							</svg>
						</a>
						<a
							href="#tracker"
							class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 text-slate-700 font-bold text-sm border border-slate-300 shadow-sm transition-all"
						>
							<span>🎯 Coba Habit Tracker (Vue)</span>
						</a>
					</div>

					<!-- Key Pillars Highlights -->
					<div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto pt-6 border-t border-slate-200/80">
						<div class="p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-slate-200/60 shadow-xs">
							<span class="text-2xl mb-1 block">🧠</span>
							<div class="text-sm font-bold text-slate-800">Growth Mindset</div>
							<div class="text-xs text-slate-500 mt-0.5">Kekuatan cara berpikir</div>
						</div>
						<div class="p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-slate-200/60 shadow-xs">
							<span class="text-2xl mb-1 block">🎯</span>
							<div class="text-sm font-bold text-slate-800">Atomic Habits</div>
							<div class="text-xs text-slate-500 mt-0.5">Sistem kebiasaan mikro</div>
						</div>
						<div class="p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-slate-200/60 shadow-xs">
							<span class="text-2xl mb-1 block">⏱️</span>
							<div class="text-sm font-bold text-slate-800">Deep Work</div>
							<div class="text-xs text-slate-500 mt-0.5">Fokus tanpa distraksi</div>
						</div>
						<div class="p-4 bg-white/70 backdrop-blur-sm rounded-2xl border border-slate-200/60 shadow-xs">
							<span class="text-2xl mb-1 block">🧘</span>
							<div class="text-sm font-bold text-slate-800">Inner Peace</div>
							<div class="text-xs text-slate-500 mt-0.5">Ketenangan & antistres</div>
						</div>
					</div>
				</div>
			</section>

			<!-- Featured Article Section -->
			{featuredPost && (
				<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 sm:-mt-14 relative z-20 mb-20">
					<div class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 border border-slate-200/80 shadow-xl shadow-slate-200/50">
						<div class="flex items-center justify-between mb-6 pb-4 border-b border-slate-100">
							<div class="flex items-center gap-2">
								<span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
								<h2 class="text-sm sm:text-base font-bold text-slate-900 uppercase tracking-wider">
									Artikel Utama Pilihan Editor
								</h2>
							</div>
							<span class="text-xs font-semibold text-emerald-600 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-100">
								Terpopuler Minggu Ini
							</span>
						</div>

						<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
							<a
								href={`/blog/${featuredPost.id}/`}
								class="lg:col-span-7 block rounded-2xl overflow-hidden group aspect-video bg-slate-100 shadow-md"
							>
								{featuredPost.data.heroImage && (
									<Image
										src={featuredPost.data.heroImage}
										alt={featuredPost.data.title}
										width={840}
										height={472}
										fetchpriority="high"
										loading="eager"
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
									/>
								)}
							</a>

							<div class="lg:col-span-5 flex flex-col justify-center">
								<div class="flex items-center gap-2.5 text-xs text-slate-500 mb-3 font-medium">
									<span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-0.5 rounded-md">
										{featuredPost.data.category}
									</span>
									<span>•</span>
									<span>
										<FormattedDate date={featuredPost.data.pubDate} />
									</span>
									<span>•</span>
									<span>{featuredPost.data.readingTime || '4 menit baca'}</span>
								</div>

								<h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold text-slate-900 hover:text-emerald-700 transition-colors leading-tight mb-4">
									<a href={`/blog/${featuredPost.id}/`}>
										{featuredPost.data.title}
									</a>
								</h3>

								<p class="text-sm sm:text-base text-slate-600 leading-relaxed mb-6">
									{featuredPost.data.description}
								</p>

								<div>
									<a
										href={`/blog/${featuredPost.id}/`}
										class="inline-flex items-center gap-2 text-sm font-bold text-white bg-slate-900 hover:bg-emerald-600 px-5 py-3 rounded-xl transition-all shadow-sm"
									>
										<span>Baca Selengkapnya</span>
										<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
											<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
										</svg>
									</a>
								</div>
							</div>
						</div>
					</div>
				</section>
			)}

			<!-- Interactive Habit Tracker (VUE COMPONENT) -->
			<section id="tracker" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
				<div class="mb-8 text-center max-w-2xl mx-auto">
					<div class="inline-flex items-center gap-1.5 text-xs font-bold text-teal-700 bg-teal-50 px-3 py-1 rounded-full border border-teal-200 mb-2">
						<span>⚡ Vue 3 Islands Architecture</span>
					</div>
					<h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
						Lacak Kebiasaan Harianmu Secara Mandiri
					</h2>
					<p class="text-xs sm:text-sm text-slate-500 mt-2">
						Komponen interaktif Vue 3 yang membantu Anda mengecek progres kebiasaan mikro setiap hari langsung di browser dengan data tersimpan otomatis.
					</p>
				</div>

				<div class="max-w-3xl mx-auto">
					<DailyHabitTracker client:visible />
				</div>
			</section>

			<!-- Interactive Articles Search & Filter (REACT COMPONENT) -->
			<section id="articles" class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-24">
				<div class="mb-8 text-center max-w-2xl mx-auto">
					<div class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 mb-2">
						<span>⚡ React 19 Interactive Island</span>
					</div>
					<h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
						Jelajahi Artikel & Wawasan Terbaru
					</h2>
					<p class="text-xs sm:text-sm text-slate-500 mt-2">
						Cari tulisan berdasarkan kata kunci, filter kategori secara instan, atau simpan artikel favorit menggunakan komponen pencarian reaktif.
					</p>
				</div>

				<!-- React Search & Filter Island -->
				<ArticleSearchFilter client:load initialArticles={articlesForReact} />
			</section>

			<!-- Newsletter & Community Call to Action -->
			<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
				<div class="bg-gradient-to-r from-emerald-800 to-teal-900 rounded-3xl p-8 sm:p-14 text-white text-center relative overflow-hidden shadow-xl">
					<div class="absolute -right-16 -top-16 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>

					<div class="relative z-10 max-w-2xl mx-auto">
						<span class="text-4xl mb-3 block">📬</span>
						<h3 class="text-2xl sm:text-4xl font-extrabold tracking-tight mb-4">
							Dapatkan Wawasan Mingguan di Inbox Anda
						</h3>
						<p class="text-sm sm:text-base text-emerald-100/80 mb-8 leading-relaxed">
							Setiap hari Minggu, kami mengirimkan satu ringkasan ide pengembangan diri yang bisa Anda terapkan dalam 5 menit. Tanpa iklan, tanpa spam.
						</p>

						<form onsubmit="event.preventDefault(); alert('Terima kasih! Wawasan inspiratif mingguan akan dikirimkan ke email Anda.');" class="flex flex-col sm:flex-row gap-2.5 max-w-md mx-auto">
							<input
								type="email"
								placeholder="Ketik email Anda..."
								required
								class="flex-1 bg-white/10 border border-white/20 rounded-xl px-4 py-3 text-sm text-white placeholder-emerald-100/50 focus:outline-none focus:ring-2 focus:ring-emerald-300"
							/>
							<button
								type="submit"
								class="bg-white hover:bg-emerald-50 text-slate-900 font-bold px-6 py-3 rounded-xl text-sm transition-all shadow-md shrink-0 cursor-pointer"
							>
								Berlangganan
							</button>
						</form>
					</div>
				</div>
			</section>
		</main>

		<Footer />
	</body>
</html>
