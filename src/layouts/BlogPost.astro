---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, readingTime, author } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-[#fafaf9] text-stone-900 antialiased selection:bg-stone-900 selection:text-white">
		<Header />
		<main class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-16">
			<article>
				<!-- Back Navigation (min 44px tap target) -->
				<div class="mb-8">
					<a
						href="/"
						class="min-h-[44px] inline-flex items-center gap-1.5 text-xs font-semibold text-stone-600 hover:text-stone-950 transition-colors py-2"
					>
						<span>←</span>
						<span>Kembali ke Halaman Depan</span>
					</a>
				</div>

				<!-- Article Header -->
				<header class="mb-10 sm:mb-12">
					<div class="flex items-center gap-2 text-xs text-stone-500 mb-4 font-medium flex-wrap">
						<span class="text-stone-900 font-bold uppercase tracking-wider text-[11px] bg-stone-100 px-2 py-0.5 rounded">
							{category || 'Mindset'}
						</span>
						<span>•</span>
						<span>
							<FormattedDate date={pubDate} />
						</span>
						<span>•</span>
						<span>{readingTime || '5 menit baca'}</span>
						{updatedDate && (
							<span class="text-stone-400 italic">
								(Diperbarui: <FormattedDate date={updatedDate} />)
							</span>
						)}
					</div>

					<h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-stone-900 tracking-tight leading-[1.15] mb-5">
						{title}
					</h1>

					{description && (
						<p class="text-base sm:text-lg text-stone-600 leading-relaxed font-normal">
							{description}
						</p>
					)}

					<div class="pt-4 mt-6 border-t border-stone-200 flex items-center justify-between text-xs text-stone-500">
						<span>Penulis: <strong>{author || 'Tim Redaksi wakeup'}</strong></span>
						<span>Publikasi: wakeup.</span>
					</div>
				</header>

				<!-- Hero Image -->
				{heroImage && (
					<div class="aspect-[16/10] w-full rounded-xl overflow-hidden bg-stone-100 border border-stone-200 mb-10 sm:mb-12">
						<Image
							width={1000}
							height={625}
							src={heroImage}
							alt={title}
							fetchpriority="high"
							loading="eager"
							class="w-full h-full object-cover"
						/>
					</div>
				)}

				<!-- Article Body with Clean Editorial Styling -->
				<div class="space-y-6 text-stone-800 text-base sm:text-lg leading-[1.8] font-normal [&_h2]:text-2xl [&_h2]:sm:text-3xl [&_h2]:font-extrabold [&_h2]:text-stone-950 [&_h2]:tracking-tight [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-stone-900 [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:mb-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-6 [&_li]:mb-2 [&_blockquote]:border-l-3 [&_blockquote]:border-stone-900 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-stone-700 [&_blockquote]:my-6 [&_strong]:text-stone-950">
					<slot />
				</div>

				<!-- Article Footnote & Navigation -->
				<div class="mt-14 pt-8 border-t border-stone-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 bg-white p-6 rounded-xl border">
					<div>
						<h4 class="font-bold text-stone-900 text-sm">Tertarik dengan topik serupa?</h4>
						<p class="text-xs text-stone-500 mt-0.5">Jelajahi tulisan reflektif lainnya di arsip lengkap kami.</p>
					</div>
					<a
						href="/blog"
						class="min-h-[44px] inline-flex items-center justify-center px-4 py-2 bg-stone-900 hover:bg-stone-800 text-stone-50 text-xs font-semibold rounded-md transition-colors"
					>
						Lihat Arsip Lengkap →
					</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
