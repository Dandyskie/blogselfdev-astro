---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, readingTime } = Astro.props;
---

<!doctype html>
<html lang="id">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="bg-slate-50 text-slate-800 antialiased selection:bg-emerald-500 selection:text-white">
		<Header />
		<main class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
			<article>
				<!-- Back Navigation -->
				<div class="mb-8">
					<a
						href="/"
						class="inline-flex items-center gap-2 text-xs sm:text-sm font-semibold text-emerald-700 hover:text-emerald-800 transition-colors bg-emerald-50 px-3.5 py-1.5 rounded-lg border border-emerald-200/60"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
						</svg>
						<span>Kembali ke Beranda</span>
					</a>
				</div>

				<!-- Article Header -->
				<header class="mb-8 sm:mb-12">
					<div class="flex items-center gap-2.5 text-xs text-slate-500 mb-4 font-medium flex-wrap">
						<span class="bg-emerald-100 text-emerald-800 font-bold px-2.5 py-1 rounded-md text-xs">
							{category || 'Mindset'}
						</span>
						<span>•</span>
						<span>
							<FormattedDate date={pubDate} />
						</span>
						<span>•</span>
						<span>{readingTime || '5 menit baca'}</span>
						{updatedDate && (
							<span class="text-slate-400 italic">
								(Diperbarui: <FormattedDate date={updatedDate} />)
							</span>
						)}
					</div>

					<h1 class="text-2xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.2] mb-4">
						{title}
					</h1>

					{description && (
						<p class="text-base sm:text-xl text-slate-600 leading-relaxed font-normal">
							{description}
						</p>
					)}
				</header>

				<!-- Hero Image with Aspect Ratio -->
				{heroImage && (
					<div class="aspect-video w-full rounded-2xl overflow-hidden bg-slate-100 shadow-md mb-10 sm:mb-14">
						<Image
							width={1020}
							height={574}
							src={heroImage}
							alt={title}
							fetchpriority="high"
							loading="eager"
							class="w-full h-full object-cover"
						/>
					</div>
				)}

				<!-- Article Prose Content with Tailwind Typography Styling -->
				<div class="prose prose-slate prose-emerald sm:prose-lg max-w-none space-y-6 text-slate-700 leading-relaxed font-normal [&_h2]:text-2xl [&_h2]:sm:text-3xl [&_h2]:font-bold [&_h2]:text-slate-900 [&_h2]:mt-10 [&_h2]:mb-4 [&_h3]:text-xl [&_h3]:font-bold [&_h3]:text-slate-800 [&_h3]:mt-6 [&_h3]:mb-2 [&_p]:mb-5 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:mb-6 [&_li]:mb-2 [&_blockquote]:border-l-4 [&_blockquote]:border-emerald-500 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-slate-600 [&_blockquote]:my-6 [&_strong]:text-slate-900">
					<slot />
				</div>

				<!-- Article End Action -->
				<div class="mt-14 pt-8 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 bg-white p-6 rounded-2xl border">
					<div>
						<h4 class="font-bold text-slate-900 text-sm">Menemukan manfaat dari tulisan ini?</h4>
						<p class="text-xs text-slate-500 mt-0.5">Jelajahi panduan pengembangan diri lainnya untuk terus bertumbuh.</p>
					</div>
					<a
						href="/blog"
						class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-white bg-emerald-600 hover:bg-emerald-700 px-4 py-2.5 rounded-xl transition-all shadow-sm"
					>
						<span>Lihat Artikel Lainnya</span>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
						</svg>
					</a>
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
