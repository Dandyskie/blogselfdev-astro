---
import { SITE_TITLE } from '../consts';
---

<header class="sticky top-0 z-50 bg-[#fafaf9]/95 backdrop-blur-sm border-b border-stone-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Brand Logo / Editorial Masthead -->
      <a href="/" class="flex items-baseline gap-2.5 group">
        <span class="text-2xl sm:text-3xl font-black tracking-tight text-stone-900 group-hover:text-stone-700 transition-colors">
          {SITE_TITLE}<span class="text-emerald-700">.</span>
        </span>
        <span class="hidden md:inline-block text-[11px] font-medium uppercase tracking-wider text-stone-500 border-l border-stone-300 pl-2.5">
          Perspektif Usia 18 sampai 30
        </span>
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden md:flex items-center gap-7 text-sm font-medium text-stone-600">
        <a href="/" class="hover:text-stone-950 transition-colors py-2">
          Beranda
        </a>
        <a href="/blog" class="hover:text-stone-950 transition-colors py-2">
          Arsip Tulisan
        </a>
        <a href="#habit-log" class="hover:text-stone-950 transition-colors py-2">
          Refleksi Harian
        </a>
        <a href="/about" class="hover:text-stone-950 transition-colors py-2">
          Tentang Kami
        </a>
      </nav>

      <!-- Action Button -->
      <div class="hidden sm:flex items-center gap-3">
        <a
          href="/blog"
          class="inline-flex items-center justify-center px-4 py-2 rounded-md bg-stone-900 hover:bg-stone-800 text-stone-50 text-xs font-semibold tracking-wide transition-colors"
        >
          Mulai Membaca
        </a>
      </div>

      <!-- Mobile Menu Toggle Button (minimum tap target 44px) -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Buka menu navigasi"
          aria-expanded="false"
          class="w-11 h-11 flex items-center justify-center text-stone-800 hover:text-stone-950 transition-colors rounded-md border border-stone-200"
        >
          <svg id="menu-icon-open" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="menu-icon-close" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="1.75" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-stone-200 bg-[#fafaf9] px-4 py-4 space-y-1">
    <a href="/" class="block px-3 py-2.5 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100">
      Beranda
    </a>
    <a href="/blog" class="block px-3 py-2.5 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100">
      Arsip Tulisan
    </a>
    <a href="#habit-log" class="block px-3 py-2.5 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100">
      Refleksi Harian
    </a>
    <a href="/about" class="block px-3 py-2.5 rounded-md text-sm font-medium text-stone-800 hover:bg-stone-100">
      Tentang Kami
    </a>
    <div class="pt-3">
      <a
        href="/blog"
        class="block w-full text-center bg-stone-900 text-stone-50 font-semibold py-2.5 rounded-md text-xs"
      >
        Mulai Membaca
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });
  }
</script>
